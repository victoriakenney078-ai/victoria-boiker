# Copy this file to .env.local and fill in the values.
# Do not commit .env.local. Next.js reads it only on this machine.

# Public. These values ship in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Server-only. Used by app/api/chat/route.ts.
# If both are empty, the gallery concierge answers from the catalog.
# XAI_API_KEY=
# OPENAI_API_KEY=

# Optional. For scripts/update-supabase-auth-urls.ps1 (never commit the real token).
# SUPABASE_ACCESS_TOKEN=

# Optional. For local wrangler — see .dev.vars.example and Cloudflare dashboard variables.
